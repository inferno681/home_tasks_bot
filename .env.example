BOT_TOKEN=your_telegram_bot_token
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net
# нужен только если service.webhook: true в config/config.yaml
WEBHOOK_SECRET=your_webhook_secret
# нужен только если fsm.storage: redis в config/config.yaml и на Redis
# настроен пароль (для локального/внутрисетевого Redis можно оставить пустым)
REDIS_PASSWORD=
